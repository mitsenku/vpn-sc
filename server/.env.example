# =============================================================================
#  .env.example — Copy to .env and fill in values
#  Generated automatically by install.sh — manual editing rarely needed
# =============================================================================

# ── Cloudflare Tunnel ─────────────────────────────────────────────────────────
# Get this from: https://one.dash.cloudflare.com → Networks → Tunnels
CF_TUNNEL_TOKEN=eyJhIjoiXXXXXXXXXXXXXXXXXXXXXXXXXXXXX...

# ── Xray Core ────────────────────────────────────────────────────────────────
# UUID for client authentication (generated by install.sh)
XRAY_UUID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# WebSocket path — randomized to prevent discovery (generated by install.sh)
WS_PATH=/a8f3b2c1d4e5

# ── VPS ───────────────────────────────────────────────────────────────────────
# Your VPS public IPv4 address (needed for REALITY fallback client config)
VPS_IP=1.2.3.4

# ── REALITY Fallback ──────────────────────────────────────────────────────────
# Set to true to enable a direct VLESS+REALITY connection on port 443
ENABLE_REALITY=true

# Generated by: docker run --rm teddysun/xray:latest xray x25519
REALITY_PRIVATE_KEY=your_private_key_here
REALITY_PUBLIC_KEY=your_public_key_here     # Share this with clients
REALITY_SHORT_ID=a1b2c3d4                   # 8 hex chars

# ── Cloudflare WARP Outbound ──────────────────────────────────────────────────
# Routes AI/streaming (ChatGPT, Netflix) through a clean Cloudflare IP
ENABLE_WARP=true

# Generated by wgcf (https://github.com/ViRb3/wgcf)
WARP_PRIVATE_KEY=your_warp_private_key_here
WARP_ADDRESS=172.16.0.2/32
# Cloudflare WARP peer public key (stable value, rarely changes)
WARP_PUBLIC_KEY=bmXOC+F1FxEMF9dyiK2H5/1SUtzH0JuVo51h2wPfgyo=
WARP_ENDPOINT=engage.cloudflareclient.com:2408
